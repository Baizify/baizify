datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generator/prisma"
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String           @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  isAdmin       Boolean          @default(false)
  campaigns     CampaignPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Competition {
  id   String @id @default(cuid())
  name String

  campaigns Campaign[]
  fixtures  Fixture[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Season {
  id   String @id @default(cuid())
  name String

  campaigns Campaign[]
  fixtures  Fixture[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Campaign {
  id            String @id @default(cuid())
  competitionId String
  seasonId      String

  teamCampaign   TeamCampaign?
  leagueCampaign LeagueCampaign?
  players        CampaignPlayer[]
  homeFixtures   Fixture[]        @relation("HomeFixtures")
  awayFixtures   Fixture[]        @relation("AwayFixtures")

  competition Competition @relation(fields: [competitionId], references: [id])
  season      Season      @relation(fields: [seasonId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model LeagueCampaign {
  campaignId          String
  played              Int    @default(0)
  points              Float  @default(0)
  pointsScoredFor     Int    @default(0)
  pointsScoredAgainst Int    @default(0)
  framesPlayed        Int    @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@id([campaignId])
}

model Team {
  id   String @id @default(cuid())
  name String

  campaigns TeamCampaign[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model TeamCampaign {
  campaignId String
  teamId     String

  team     Team     @relation(fields: [teamId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@id([campaignId])
}

model TeamCampaignPlayer {
  campaignPlayerId String
  isTeamCaptain    Boolean

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@id([campaignPlayerId])
}

model CampaignPlayer {
  id         String @id @default(cuid())
  campaignId String
  userId     String

  user       User     @relation(fields: [userId], references: [id])
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  homeFrames Frame[]  @relation("HomeFrames")
  awayFrames Frame[]  @relation("AwayFrames")
  wonFrames  Frame[]  @relation("WonFrames")

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Fixture {
  id             String    @id @default(cuid())
  competitionId  String
  seasonId       String
  homeCampaignId String
  awayCampaignId String
  scheduledDate  DateTime?
  actualDate     DateTime?
  homeScore      Int       @default(0)
  awayScore      Int       @default(0)
  status         String    @default("scheduled") // scheduled, in_progress, completed, cancelled
  venue          String?
  notes          String?

  competition  Competition @relation(fields: [competitionId], references: [id])
  season       Season      @relation(fields: [seasonId], references: [id])
  homeCampaign Campaign    @relation("HomeFixtures", fields: [homeCampaignId], references: [id])
  awayCampaign Campaign    @relation("AwayFixtures", fields: [awayCampaignId], references: [id])
  frames       Frame[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Frame {
  id           String  @id @default(cuid())
  fixtureId    String
  frameNumber  Int
  homePlayerId String?
  awayPlayerId String?
  homeScore    Int     @default(0)
  awayScore    Int     @default(0)
  winnerId     String?
  status       String  @default("not_started") // not_started, in_progress, completed
  notes        String?

  fixture    Fixture         @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  homePlayer CampaignPlayer? @relation("HomeFrames", fields: [homePlayerId], references: [id])
  awayPlayer CampaignPlayer? @relation("AwayFrames", fields: [awayPlayerId], references: [id])
  winner     CampaignPlayer? @relation("WonFrames", fields: [winnerId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([fixtureId, frameNumber])
}
